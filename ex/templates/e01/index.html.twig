{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1>{{ message }}</h1>
	<p> Coucou, tu es connecté !</p> 
    {% if app.user %}
        <a href="{{ path('app_logout') }}">Se déconnecter</a>
    {% else %}
        <a href="{{ path('app_login') }}">Se connecter</a> |
        <a href="{{ path('app_register') }}">S'inscrire</a>
    {% endif %}
{% endblock %}