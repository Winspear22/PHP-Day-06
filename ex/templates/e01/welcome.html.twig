{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1>{{ message }}</h1>

    {% if app.user %}
        <p>Coucou, tu es connecté {{ app.user.userIdentifier }} (Réputation : {{ app.user.getReputation() }}) ! (Ceci est un message du front).</p>
        <p>Tu as bien pu accéder à la page Welcome après t'être connecté !</p>
        <p>Ton rôle est : {{ app.user.roles|join(', ') }}</p>

        {% if is_granted('ROLE_ADMIN') %}
            <p>Vu que tu es admin, tu peux avoir accès à ce panneau de configuration :</p>
            <a href="{{ path('e02_admin_panel') }}">Panneau d'administration</a>
            <br>
        {% else %}
            <p>Malheureusement, tu n'es pas administrateur, tu ne peux donc pas accéder au panneau d'administration.</p>
        {% endif %}

        <hr>

        <h2>📜 Liste des posts</h2>

        {% if posts is defined and posts|length > 0 %}
            <table border="1" cellpadding="5">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Date</th>
                        <th>Contenu</th>
                        <th>Votes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                        {% set isAuthor = app.user and post.author and post.author.id == app.user.id %}
                        {% set rep = app.user ? app.user.getReputation() : 0 %}
                        {% set canLike = app.user and rep >= 3 and not isAuthor %}
                        {% set canDislike = app.user and rep >= 6 and not isAuthor %}
                        {% set isAdmin = app.user and 'ROLE_ADMIN' in app.user.roles %}
                        {% set canEdit = app.user and (isAuthor or isAdmin or rep >= 9) %}
                        {% set myVote = null %}
                        {% if app.user %}
                            {% for v in post.votes %}
                                {% if v.user and v.user.id == app.user.id %}
                                    {% set myVote = v %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        {% set liked = myVote and myVote.isLike %}
                        {% set disliked = myVote and (not myVote.isLike) %}

                        <tr>
                            <td>
                                <a href="{{ path('e03_read_post_details', {id: post.id}) }}">
                                    {{ post.title }}
                                </a>
                            </td>
                            <td>{{ post.author.username }} (Réputation : {{ post.author.reputation }})</td>
                            <td>{{ post.created|date('d/m/Y H:i') }}</td>
                            <td>{{ post.content }}</td>

                            {# --- Compteurs --- #}
                            <td class="vote">
                                <span class="count">👍 {{ post.countLikes() }}</span>
                                <span class="count">👎 {{ post.countDislikes() }}</span>
                            </td>
                            {# --- Flèches like/dislike --- #}
                            <td class="vote">
                                {# Like ▲ #}
                                {% if canLike %}
                                    <a class="{{ liked ? 'active' : '' }}"
                                       href="{{ path('e05_vote', { id: post.id, type: 'like', from: 'welcome'}) }}"
                                       title="Like">▲</a>
                                {% else %}
                                    <span class="disabled" title="{% if not app.user %}Connecte-toi pour voter{% elseif isAuthor %}Impossible de voter son propre post{% else %}Il faut 3+ de réputation{% endif %}">▲</span>
                                {% endif %}

                                {# Dislike ▼ #}
                                {% if canDislike %}
                                    <a class="{{ disliked ? 'active' : '' }}"
                                       href="{{ path('e05_vote', { id: post.id, type: 'dislike', from: 'welcome' }) }}"
                                       title="Dislike">▼</a>
                                {% else %}
                                    <span class="disabled" title="{% if not app.user %}Connecte-toi pour voter{% elseif isAuthor %}Impossible de voter son propre post{% else %}Il faut 6+ de réputation{% endif %}">▼</span>
                                {% endif %}

                                {# Edit ✏️ #}
                                {% if canEdit %}
                                    <a href="{{ path('e06_edit', { id: post.id }) }}">Modifier ce post</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p><em>Aucun post pour le moment.</em></p>
        {% endif %}

        <br>
        <a href="{{ path('e03_create_post') }}">✍️ Créer un nouveau post</a>
        <br><br>

        <a href="{{ path('e01_index') }}">Retourner à l'index</a> |
        <a href="{{ path('app_logout') }}">Se déconnecter</a>
    {% endif %}
{% endblock %}
