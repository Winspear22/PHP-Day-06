{% extends 'base.html.twig' %}

{% block title %}Détails du post{% endblock %}

{% block body %}
    <h1>{{ post.title }}</h1>
    <p><strong>Auteur :</strong> {{ post.author.username }} (Réputation : {{ post.author.reputation }})</p>
    <p><strong>Date :</strong> {{ post.created|date('d/m/Y H:i') }}</p>
    <p>{{ post.content }}</p>

    <hr>

    <div class="vote">
        <strong>Votes :</strong>
        <span class="count">👍 {{ post.countLikes() }}</span>
        <span class="count">👎 {{ post.countDislikes() }}</span>
    </div>

    <div class="vote" style="margin-top:.5rem;">
        {# --- Calcul du droit et vote utilisateur --- #}
        {% set myVote = null %}
        {% if app.user %}
            {% for v in post.votes %}
                {% if v.user and v.user.id == app.user.id %}
                    {% set myVote = v %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {% set liked = myVote and myVote.isLike %}
        {% set disliked = myVote and (not myVote.isLike) %}
        {% set isAuthor = app.user and post.author and post.author.id == app.user.id %}
        {% set rep = app.user ? app.user.getReputation() : 0 %}
        {% set isAdmin = app.user and 'ROLE_ADMIN' in app.user.roles %}
        {# Ici on donne le droit à l'admin ou si palier atteint, sauf pour son propre post #}
        {% set canLike = app.user and (rep >= 3 or isAdmin) and not isAuthor %}
        {% set canDislike = app.user and (rep >= 6 or isAdmin) and not isAuthor %}
        {% set canEdit = app.user and (isAuthor or isAdmin or rep >= 9) %}

        {# Like ▲ #}
        {% if canLike %}
            <a class="{{ liked ? 'active' : '' }}"
            href="{{ path('e05_vote', { id: post.id, type: 'like', from: 'details' }) }}"
            title="Like">▲</a>
        {% else %}
            <span class="disabled"
            title="{% if not app.user %}Connecte-toi pour voter{% elseif isAuthor %}Impossible de voter son propre post{% else %}Il faut 3+ de réputation ou être admin{% endif %}">▲</span>
        {% endif %}

        {# Dislike ▼ #}
        {% if canDislike %}
            <a class="{{ disliked ? 'active' : '' }}"
            href="{{ path('e05_vote', { id: post.id, type: 'dislike', from: 'details' }) }}"
            title="Dislike">▼</a>
        {% else %}
            <span class="disabled"
                title="{% if not app.user %}Connecte-toi pour voter{% elseif isAuthor %}Impossible de voter son propre post{% else %}Il faut 6+ de réputation ou être admin{% endif %}">▼</span>
        {% endif %}

        {# Edit #}
        {% if canEdit %}
            <a href="{{ path('e06_edit', { id: post.id }) }}">Modifier ce post</a>
        {% endif %}
    </div>
    {% if post.lastEditedBy %}
        <p>Dernière modification par {{ post.lastEditedBy.username }} le {{ post.lastEditedAt|date('d/m/Y H:i') }}</p>
    {% endif %}
    <br>
    <a href="{{ path('e01_welcome') }}">Retour aux posts</a>
{% endblock %}
